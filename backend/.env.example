# Copy to .env (or export) before starting the backend.
# Default is a local SQLite file. For PostgreSQL (as in the synopsis) use:
# DATABASE_URL=postgresql+psycopg2://locallink:locallink@localhost:5432/locallink
DATABASE_URL=sqlite:///./locallink.db
SECRET_KEY=change-me-in-production
# 1 = use Sentence-BERT if installed, 0 = always use the TF-IDF fallback
USE_TRANSFORMER=1
